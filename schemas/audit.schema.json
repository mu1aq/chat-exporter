{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shared-chat-exporter:schema:audit:1",
  "title": "Shared Chat Exporter integrity audit",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "provider",
    "source",
    "exportedAt",
    "fileCount",
    "files",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "shared-chat-exporter"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "provider": {
      "type": ["string", "null"]
    },
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "exportedAt": {
      "type": ["string", "null"]
    },
    "fileCount": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
